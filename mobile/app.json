{
  "expo": {
    "name": "Simfinity",
    "slug": "simfinity",
    "version": "1.0.0",
    "scheme": "simfinity",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050505",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.simfinity.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#131313",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.simfinity.app",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Simfinity needs photo access to set your profile picture."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FFD700"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Simfinity uses your location to center the coverage map and show nearby cell tower signal."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 320,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ce5011a5-f3fd-4e43-bcef-857d219e72c4"
      }
    },
    "owner": "sencherey"
  }
}
