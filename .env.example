# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Paystack Payment Gateway Integration Keys
PAYSTACK_SECRET_KEY=

# eSIM Provider Core Network Integration Keys (Celitech Sandbox etc.)
ESIM_PROVIDER_API_KEY=
ZENDIT_API_KEY=sand_39f37bfb-25f7-4de4-9564-024003cde0d46a2b28a84063e9f8a9c79227

# ── Travel Insights (Home screen spotlights) ───────────────────────────────
# Optional — enables live travel trivia; falls back to curated content if unset
GEMINI_API_KEY=

# ── Resend (transactional email) ───────────────────────────────────────────
# Required for email verification, password reset, and gift eSIM emails
# Get your key from https://resend.com — free tier: 3000 emails/month
RESEND_API_KEY=re_...

# ── App base URL (used in email links) ─────────────────────────────────────
# Set to your public URL in production; localhost works for local testing
APP_BASE_URL=http://localhost:3000

# ── OpenCellID (coverage heatmap) ──────────────────────────────────────────
# Optional — get a free key from https://opencellid.org
OPENCELLID_API_KEY=
