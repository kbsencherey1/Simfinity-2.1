# ── Paystack (payment gateway) ─────────────────────────────────────────────
# Get your test key from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_test_...

# ── Zendit (eSIM provisioning) ──────────────────────────────────────────────
# Sandbox key works out of the box — replace with live key for production
ZENDIT_API_KEY=sand_39f37bfb-25f7-4de4-9564-024003cde0d46a2b28a84063e9f8a9c79227

# ── Travel Insights (Home screen spotlights) ───────────────────────────────
# Optional — enables live travel trivia; falls back to curated content if unset
GEMINI_API_KEY=

# ── Brevo (transactional email) ────────────────────────────────────────────
# Required for email verification, password reset, and gift eSIM emails
# Get your key from https://app.brevo.com/settings/keys/api
# The "from" address in EmailService.java must be a verified sender in your
# Brevo account (Senders & IP → Senders) or sends will fail.
BREVO_API_KEY=xkeysib-...

# ── App base URL (used in email links) ─────────────────────────────────────
# Set to your public URL in production; localhost works for local testing
APP_BASE_URL=http://localhost:3000

# ── OpenCellID (coverage heatmap) ──────────────────────────────────────────
# Optional — get a free key from https://opencellid.org
OPENCELLID_API_KEY=
